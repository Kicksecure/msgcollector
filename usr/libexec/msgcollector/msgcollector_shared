## style-ok: no-strict
##
## No strict-mode preamble: this file is SOURCED, never executed, so a 'set -o'
## block here would rewrite the CALLER's shell rather than govern this code.
## Its callers (msgprogress, msgdispatcher, msgdispatcher_run_check) carry the
## R-010 preamble themselves, which is what these functions actually run under
## -- see the ':-' in loop_protection below.

source /usr/libexec/helper-scripts/light_sleep.bsh
source /usr/libexec/helper-scripts/strings.bsh

folder_init() {
   ## Honor XDG_RUNTIME_DIR (the systemd / XDG base-dir spec env
   ## var for the user's runtime directory). On a logind session
   ## this is /run/user/$(id -u); in containers / chroots / CI
   ## runners that lack a logind setup, the consumer (e.g. the
   ## integration-test harness) can export an alternate path so
   ## every msgcollector subprocess uses the same dir.
   msgcollector_run_id_folder="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
   if test -d "${msgcollector_run_id_folder}" ; then
      true "folder_init: INFO: msgcollector_run_id_folder exists."
      msgcollector_run_dir="${msgcollector_run_id_folder}/msgcollector"
      if ! test -d "${msgcollector_run_dir}" ; then
         mkdir --parents -- "${msgcollector_run_dir}"
      fi
   else
      true "folder_init: INFO: msgcollector_run_id_folder does not exist. Falling back to mktemp."
      msgcollector_run_dir="$(mktemp --directory)"
   fi
}

loop_protection() {
   ## ':-' because the FIRST call has no counter yet, and the line below is the
   ## one that creates it. The unset-safe default belongs here, in the shared
   ## helper, not in the callers: msgprogress and msgdispatcher_run_check both
   ## call this under nounset, so fixing it in one would leave the other
   ## aborting. Without it, every '--progressx' update exited before writing
   ## the progress value.
   if ! is_whole_number "${loop_counter_protection:-}"; then
      loop_counter_protection="0"
      ## Do not wait on first run of this function.
      return 0
   fi
   loop_counter_protection="$(( loop_counter_protection + 1 ))"
   if [ "${loop_counter_protection}" -gt "60" ]; then
      ## Timeout reached.
      exit 2
   fi
   light_sleep 1
}
