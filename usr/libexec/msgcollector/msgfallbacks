## This file gets sourced by msgdispatcher and msgprogressbar.
## Therefore the error_handler function has been already load.

## style-ok: no-strict
##
## No strict-mode preamble: this file is SOURCED, never executed, so a 'set -o'
## block here would rewrite the CALLER's shell instead of governing this code.
## Both callers carry the R-010 preamble themselves, which is what 'fallbacks'
## actually runs under -- see the ':-' defaults below.

## The dummy yad / kdialog / notify-send below SHADOW the real commands, so
## every later call to those names reaches these bodies. shellcheck sees a
## function that nothing in this file invokes and calls it unreachable; the
## indirection is the whole point of the file.
# shellcheck disable=SC2317

fallbacks() {
   trap "error_handler" ERR

   ## ':-' because deciding whether there is a GUI is exactly the case where
   ## these are unset: a headless or pure-Wayland session has no DISPLAY. This
   ## file is SOURCED into msgdispatcher and msgprogressbar, both of which run
   ## under nounset, so reading them bare aborted before the no-GUI fallback
   ## could be installed -- in the one environment the fallback exists for.
   ## The default lives here rather than in the callers, since both reach it.
   if [ "${DISPLAY:-}" = "" ] && [ "${WAYLAND_DISPLAY:-}" = "" ]; then
      no_gui="1"
   else
      no_gui="0"
   fi

   ## Check if 'yad' is installed.
   ## - This is not the case for cli users,
   ##   who removed yad or custom builds which never had 'yad' installed.
   if ! has yad || [ "${no_gui}" = "1" ]; then
      ## 'yad' is not installed or no Wayland / X server running.
      yad() {
         ## dummy
         true
      }
   fi

   if ! has kdialog || [ "${no_gui}" = "1" ]; then
      ## kdialog is not installed or no Wayland / X server running.
      kdialog() {
         ## dummy
         true
      }
   fi

   if ! has notify-send || [ "${no_gui}" = "1" ]; then
      ## notify-send is not installed or no Wayland / X server running.
      notify-send() {
         ## dummy
         true
      }
   fi
}
